{
  "name": "pi-gui-next",
  "version": "0.0.1",
  "private": true,
  "description": "Linux desktop workbench for Pi Coding Agent",
  "desktopName": "io.pi-gui.next.desktop",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": "26.4.0",
    "pnpm": "11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "electron-vite dev",
    "preview:browser": "vite --config vite.browser-preview.config.ts",
    "typecheck": "tsc --noEmit",
    "test:core": "node --test scripts/memory-event-metrics.test.mjs src/main/advisor/*.test.ts src/main/export/*.test.ts src/main/extension/*.test.ts src/main/git/*.test.ts src/main/pi-rpc/*.test.ts src/main/runtime/*.test.ts src/main/kernel/*.test.ts src/main/notification/*.test.ts src/main/project/*.test.ts src/main/provider/*.test.ts src/main/security/*.test.ts src/main/subagent/*.test.ts src/renderer/src/*.test.ts src/renderer/src/composition/*.test.ts src/renderer/src/features/chat/*.test.ts src/renderer/src/features/composer/*.test.ts src/renderer/src/features/git/*.test.ts src/renderer/src/features/project/*.test.ts src/shared/*.test.ts extensions/pi-gui-runtime-quiescence/tests/*.test.mjs extensions/pi-gui-multi-advisor/tests/quiescence-provider.test.mjs extensions/pi-gui-task-notify/tests/quiescence-provider.test.mjs extensions/pi-gui-ask/tests/quiescence-provider.test.mjs extensions/pi-gui-openai-fast-mode/tests/*.test.ts",
    "bench:markdown": "node scripts/benchmark-streaming-markdown.ts",
    "smoke:pi": "pnpm build && PI_GUI_PROBE_ONLY=1 electron .",
    "build": "electron-vite build",
    "package:linux": "pnpm build && electron-builder --linux AppImage --x64 --publish never",
    "verify:linux": "node scripts/verify-linux-release.mjs"
  },
  "build": {
    "appId": "io.pi-gui.next",
    "productName": "Pi GUI",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extensions/pi-gui-task-notify/assets/pi-notify.png",
        "to": "pi-notify.png"
      },
      {
        "from": "extensions/pi-gui-runtime-quiescence",
        "to": "extensions/pi-gui-runtime-quiescence",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extensions/pi-gui-task-notify",
        "to": "extensions/pi-gui-task-notify",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extensions/pi-gui-ask",
        "to": "extensions/pi-gui-ask",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extensions/pi-gui-openai-fast-mode",
        "to": "extensions/pi-gui-openai-fast-mode",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "executableName": "pi-gui-next",
      "artifactName": "pi-gui-next-${version}-${arch}.${ext}",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.9",
    "ignore": "7.0.5",
    "katex": "0.16.47",
    "proper-lockfile": "4.1.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math-extended": "6.1.0",
    "remark-parse": "11.0.0",
    "simple-git": "3.36.0",
    "unified": "11.0.5",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
