{
  "name": "pi-gui-next",
  "version": "0.0.1",
  "private": true,
  "description": "Linux desktop workbench for Pi Coding Agent",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": "26.4.0",
    "pnpm": "11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test:core": "node --test src/main/pi-rpc/*.test.ts src/main/runtime/*.test.ts src/main/kernel/*.test.ts src/main/project/*.test.ts src/main/security/*.test.ts src/renderer/src/features/chat/streaming-markdown.test.ts",
    "bench:markdown": "node scripts/benchmark-streaming-markdown.ts",
    "smoke:pi": "pnpm build && PI_GUI_PROBE_ONLY=1 electron .",
    "build": "electron-vite build"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
